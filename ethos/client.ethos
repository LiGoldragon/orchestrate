; Orchestrate CLI client failure vocabulary.
;
; Situated is declared locally because protos::Situated<F> lacks
; PartialEq/Eq derives that the Library emitter requires. The shape
; is identical to datomic::Situated<datomic::Fault>.

Library.{ 0 29 0 }
[ protos:[ Extent ]
  datomic:[ Fault ]
  signal_orchestrate:Refusal ]
[ Situated.{ Option<Extent> Fault }
  ClientFailure.[ Unreadable.Situated Unreachable.{ Text Text } Refused.Refusal ] ]
[]
[]
